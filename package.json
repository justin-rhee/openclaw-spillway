{
  "name": "openclaw-spillway",
  "version": "0.1.0",
  "description": "Proactive quota-aware failover for OpenClaw: spill work to a backup lane before a usage window runs out.",
  "type": "module",
  "license": "MIT",
  "author": "Justin Rhee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justin-rhee/openclaw-spillway.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "quota",
    "rate-limit",
    "failover",
    "model-routing"
  ],
  "openclaw": {
    "extensions": ["./src/index.ts"],
    "compat": {
      "pluginApi": ">=2026.6.11",
      "minGatewayVersion": "2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.6.11",
      "pluginSdkVersion": "2026.6.11"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openclaw": "2026.6.11",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
